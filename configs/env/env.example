# Environment template for the CV Pipeline backend stack.
#
# Copy to configs/env/.env and fill in every value marked REQUIRED.
# The local stack (infra/local/docker-compose.yml) refuses to start if a
# REQUIRED secret is unset. The committed .env is gitignored; never commit
# real secrets. Values below are safe local defaults.

# --- Database (Postgres) ---
# Compose builds the backend's DB_URL from POSTGRES_USER / _PASSWORD / _DB,
# so the DB_URL line is only used for direct connections (e.g. running
# Alembic from your workstation). Keep the +asyncpg driver: the backend
# uses async SQLAlchemy and create_async_engine requires it.
POSTGRES_USER=cvuser
POSTGRES_DB=cvdb
# REQUIRED
POSTGRES_PASSWORD=
DB_URL=postgresql+asyncpg://cvuser:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/cvdb

# --- Model weights ÔÇö choose ONE option ---
# Option A (default): auto-download a registered version on first use.
MODEL_VERSION=unet-v1
# Option B: explicit local checkpoint (comment out MODEL_VERSION if used).
# MODEL_PATH=/absolute/path/to/best_model.pth

# --- Authentication (R9, task #490) ---
# API_KEY and ADMIN_API_KEY seed the default researcher and admin users on
# first DB init. Generate each with: openssl rand -hex 32
# REQUIRED
API_KEY=
# REQUIRED
ADMIN_API_KEY=

# --- Auth: GitHub OAuth ---
# Register an OAuth App under GitHub -> Settings -> Developer settings.
# Dev callback: http://localhost:8000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Origin the backend redirects the browser back to after login. Must match
# the origin the frontend is served from (Next.js dev + compose = :3000).
FRONTEND_URL=http://localhost:3000

# --- Auth: JWT ---
# Generate with: openssl rand -hex 32
# REQUIRED
JWT_SIGNING_KEY=
JWT_TTL_MIN=60

# --- Auth: Authlib OAuth-state cookie ---
# Independent from JWT_SIGNING_KEY. Generate with: openssl rand -hex 32
# REQUIRED
SESSION_SECRET=

# --- Auth: cookie session ---
# Set "true" only behind HTTPS; keep false for local http.
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated browser origins. List explicit origins, NOT "*": the backend
# runs credentialed CORS and browsers reject "*" when credentials are sent.
CORS_ORIGINS=http://localhost:3000

# --- Feedback image storage (retraining flywheel landing zone) ---
# local -> writes to FEEDBACK_STORAGE_LOCAL_DIR (a persisted volume).
# blob  -> Azure Blob; requires the two BLOB_* values + azure-storage-blob.
FEEDBACK_STORAGE_BACKEND=local
FEEDBACK_STORAGE_LOCAL_DIR=/data/feedback
# FEEDBACK_STORAGE_BLOB_CONNECTION_STRING=
# FEEDBACK_STORAGE_BLOB_CONTAINER=

# --- Model serving (cloud) ---
# Set MODEL_ENDPOINT_URL to delegate inference to an Azure ML endpoint
# (flips the backend into azure_ml mode). Leave both commented for a
# self-contained local-weights run.
# MODEL_ENDPOINT_URL=
# MODEL_ENDPOINT_KEY=

# --- Monitoring thresholds (specification section 13, R15) ---
ALERT_CONFIDENCE_MIN=0.60
ALERT_LOW_CONF_FRACTION=0.20
ALERT_LATENCY_P95_MS=5000
ALERT_ERROR_RATE=0.05
RETRAIN_FEEDBACK_THRESHOLD=50

# --- Optional overrides (read by code; sensible defaults apply if unset) ---
# LOG_LEVEL=INFO
# CV_PIPELINE_CACHE_DIR=~/.cache/cv-pipeline/models
# EXPLAIN_TIMEOUT_SECONDS=90

# --- Azure (NOT used by the local backend; read by scripts/azure, CI, Airflow) ---
# These are identifiers, not secrets. The service-principal SECRET lives in
# the Airflow env, not here. They have NO defaults: scripts/azure exits with a
# message naming the missing variable rather than falling back to someone
# else's subscription.
# the Airflow env, not here. MODEL_NAME is read by the cloud deploy/train
# scripts and Airflow DAGs.
MODEL_NAME=baseline
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_WORKSPACE_NAME=
AZURE_RESOURCE_GROUP=