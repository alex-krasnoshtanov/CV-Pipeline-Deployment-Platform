# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*_credentials.json
service-principal*.json
azure-credentials*
configs/env/*
!configs/env/*.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- Node / Next.js ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- Build + coverage ---
dist/
build/
.coverage
coverage.xml
htmlcov/

# --- Data (keep the folders, not the contents) ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/
checkpoints/

# --- Model weights: ship via GitHub Releases, not git ---
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors
models/**/*.pth
._model_check/

# --- Airflow runtime ---
infra/airflow/logs/
infra/airflow/plugins/
*.log
# ...but training logs under models/ are deliberate artefacts. Without this
# negation the *.log rule above swallows them silently.
!models/**/training.log
# Same for the captured pipeline and training runs under docs/evidence/. These
# are the documentation's evidence, referenced by name from docs/delivery/, so
# the *.log rule dropping them would leave dead links in a published repo.
!docs/evidence/**/*.log

# --- Smoke-test images: 102 MB across 10 files, never tracked upstream.
# Ship downsampled crops or a Release asset, not this.
smoke_set/

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Scratch ---
response.json
tmp_*/
PLAN.md

# NOTE: the group repo ignored *.png globally. Deliberately not copied here —
# this repo will want architecture diagrams and result images committed.
# Large raster data is covered by the data/ rules above instead.
